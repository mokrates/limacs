(load "lib/util.limo")
(load "lib/buffer.limo")
(load "lib/modes.limo")
(defun p (x) (print (string-concat (repr x) "\n")))
(define-key *global-map* "C-x C-f" 'find-file)
(define-key *global-map* "M-f" 'forward-word)
(p (kbd-parse "C-x M-f RET"))
(p (dictp (lookup-key *global-map* (quote ("C-x")))))
(p (lookup-key *global-map* '("C-x" "C-f")))
(p (lookup-key *global-map* '("ESC" "f")))
(define-major-mode text-mode () "Text" :vars '((fill-column . 60)))
(define-major-mode foo-mode text-mode "Foo" :x 1)
(define-minor-mode bar-mode "Bar" :y 2)
(set-buffer (create-buffer "x"))
(set-major-mode 'foo-mode)
(p (buffer-prop ':x)) (p (mode-chain 'foo-mode)) (p (var 'fill-column))
(enable-minor-mode 'bar-mode)
(p (buffer-prop ':y)) (p (mode-line-modes))
(exit)
