(load "lib/util.limo")
(load "lib/buffer.limo")
(defun p (x) (print (string-concat (repr x) "\n")))
(set-buffer (create-buffer "x"))
(insert "hello\nworld foo\nbar")
(p (buffer-string)) (p (point))
(delete-between (cons 0 3) (cons 1 2))
(p (buffer-string)) (p (point)) (p (buf-nlines))
(insert-at (cons 0 0) "AAA\nBBB\n")
(p (buffer-string)) (p (buf-nlines))
(buffer-undo) (p (buffer-string))
(buffer-undo) (p (buffer-string))
(buffer-undo) (p (buffer-string))
(buffer-redo) (p (buffer-string))
(buffer-redo) (buffer-redo) (p (buffer-string)) (p (point))
(set-line-indentation 0 4) (p (buffer-string))
(exit)
