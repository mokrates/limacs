(load "lib/util.limo")
(defun p (x) (print (string-concat (repr x) "\n")))
(p (substr "hello" 1 3))
(p (split-lines "a\nb\n\nc"))
(p (join-lines '("a" "b")))
(p (str-index "hello world" "o w" 0))
(p (str-upcase "abc é"))
(p (u8-next "aéb" 1))
(p (u8-prev "aéb" 3))
(p (display-col "a\tb" 2 8))
(p (u8-encode 955))
(p (u8-length (u8-encode 8594)))
(p (byte-at-col "a\tbc" 9 8))
(p (str-trim "  hi  "))
(p (list-index 3 '(1 2 3)))
(exit)
