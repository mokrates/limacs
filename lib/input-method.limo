;; -*- limo -*-
;; limacs/lib/input-method.limo --- input methods (a small "quail").
;;
;; An input method translates typed key sequences into other text, e.g.
;; \alpha -> α.  Pending sequences are shown underlined in the buffer and
;; replaced as soon as they're complete.  Modes control input methods:
;;   :input-method          method switched on when the mode starts
;;   :input-method-context  predicate: may the method act at point?
;; (see c-mode: only inside comments).

(setq *input-methods* (make-dict))

(defun define-input-method (name doc rules)         ; rules: list of (keys . output)
  (let ((m (make-dict)) (rd (make-dict)) (pd (make-dict)))
    (for-each r rules
      (dput rd (car r) (cdr r))
      (let ((i 1) (k (car r)))
        (while (< i (slen k))
          (unless (u8-cont-p k i) (dput pd (substr k 0 i) :t))
          (setf i (+ i 1)))))
    (dput m 'doc doc) (dput m 'rules rd) (dput m 'prefixes pd)
    (dput *input-methods* name m)
    name))

(defun input-method-names () (sort string< (dkeys *input-methods*)))

(defun im-state-ensure ()
  (let ((st (bf im-state)))
    (unless st (setf st (make-dict)) (dput st 'keys ()) (dput st 'len 0) (dput st 'start (point)) (bf! im-state st))
    st))

(defun im-context-ok ()
  (let ((f (buffer-prop ':input-method-context))) (if f (f) :t)))

(defun im-display (st seq m)
  (let ((text (or (dget (dget m 'rules) seq) seq)))
    (if (and (dget st 'keys) (> (dget st 'len) 0))
        (delete-between (dget st 'start) (point))
        (dput st 'start (point)))
    (insert text)
    (dput st 'keys seq) (dput st 'len (slen text))))
(defun im-commit (st) (dput st 'keys ()) (dput st 'len 0))

(defun im-handle-char (ch)                           ; true when the method consumed CH
  (let* ((m (dget *input-methods* (bf im))) (st (im-state-ensure)) (keys (dget st 'keys)))
    (cond ((not m) ())
          ((and keys (not (pos= (point) (end-pos-after (dget st 'start) (or (dget (dget m 'rules) keys) keys)))))
           (im-commit st) (im-handle-char ch))              ; point moved: forget pending keys
          ((and (not keys) (not (im-context-ok))) ())
          (:else
           (let* ((seq (string-concat (or keys "") ch))
                  (exact (dhas (dget m 'rules) seq)) (prefix (dhas (dget m 'prefixes) seq)))
             (cond ((or exact prefix)
                    (im-display st seq m)
                    (when (and exact (not prefix)) (im-commit st))
                    :t)
                   (keys (im-commit st) (im-handle-char ch))
                   (:else ())))))))

(defun im-reset () (let ((st (bf im-state))) (when st (dput st 'keys ()) (dput st 'len 0))))

(defun im-backspace ()                                ; DEL while a sequence is pending
  (let* ((st (bf im-state)) (m (dget *input-methods* (bf im))) (keys (dget st 'keys)))
    (cond ((not keys) ())
          (:else
           (let ((nk (substr keys 0 (u8-prev keys (slen keys)))))
             (cond ((= (slen nk) 0) (delete-between (dget st 'start) (point)) (im-commit st))
                   (:else (im-display st nk m))))
           :t))))

(defun set-input-method (name)
  (unless (dhas *input-methods* name) (user-error "No such input method: %s" name))
  (bf! im name) (bf! im-last name) (bf! im-state ())
  (message "Input method: %s -- %s" name (dget (dget *input-methods* name) 'doc)))
(defun deactivate-input-method () (bf! im ()) (bf! im-state ()) (message "Input method off"))

(defcommand toggle-input-method () "Turn the current input method on or off."
  (if (bf im) (deactivate-input-method)
      (set-input-method (or (bf im-last) (buffer-prop ':input-method) (var 'default-input-method) "tex"))))
(defcommand set-input-method-command () "Choose an input method."
  (set-input-method (read-minibuffer "Input method: " "" (input-method-names) 'im)))
(register-command 'set-input-method set-input-method-command "Choose an input method.")
(defvar* 'input-method-auto :t)
(defvar* 'default-input-method "tex")

;;; ------------------------------------------------------------------
;;; the methods

(defun accent-rules (prefix pairs)                    ; pairs: ("a" . "ä") ...
  (map1 (lambda (p) (cons (string-concat prefix (car p)) (cdr p))) pairs))
(defun postfix-rules (suffix pairs)
  (map1 (lambda (p) (cons (string-concat (car p) suffix) (cdr p))) pairs))

(setq *umlauts* '(("a" . "ä") ("o" . "ö") ("u" . "ü") ("A" . "Ä") ("O" . "Ö") ("U" . "Ü") ("e" . "ë") ("i" . "ï") ("E" . "Ë") ("I" . "Ï") ("s" . "ß")))
(setq *acutes* '(("a" . "á") ("e" . "é") ("i" . "í") ("o" . "ó") ("u" . "ú") ("y" . "ý") ("A" . "Á") ("E" . "É") ("I" . "Í") ("O" . "Ó") ("U" . "Ú")))
(setq *graves* '(("a" . "à") ("e" . "è") ("i" . "ì") ("o" . "ò") ("u" . "ù") ("A" . "À") ("E" . "È") ("I" . "Ì") ("O" . "Ò") ("U" . "Ù")))
(setq *circs* '(("a" . "â") ("e" . "ê") ("i" . "î") ("o" . "ô") ("u" . "û") ("A" . "Â") ("E" . "Ê") ("I" . "Î") ("O" . "Ô") ("U" . "Û")))
(setq *tildes* '(("n" . "ñ") ("N" . "Ñ") ("a" . "ã") ("o" . "õ") ("A" . "Ã") ("O" . "Õ")))

(define-input-method "latin-1-prefix" "type \"a for ä, 'e for é, `e for è, ^o for ô, ~n for ñ, /o for ø"
  (append (accent-rules "\"" *umlauts*) (accent-rules "'" *acutes*) (accent-rules "`" *graves*)
          (accent-rules "^" *circs*) (accent-rules "~" *tildes*)
          '(("/o" . "ø") ("/O" . "Ø") ("/a" . "å") ("/A" . "Å") (",c" . "ç") (",C" . "Ç") ("<<" . "«") (">>" . "»") ("!!" . "¡") ("??" . "¿") ("EUR" . "€"))))

(define-input-method "german-postfix" "type a\" for ä, o\" for ö, u\" for ü, s\" for ß"
  (append (postfix-rules "\"" *umlauts*) '(("sz" . "ß") ("SZ" . "ẞ"))))

(define-input-method "typography" "-> → <- ← => ⇒ <= ≤ >= ≥ != ≠ -- – --- — ... … (c) © 1/2 ½"
  '(("->" . "→") ("<-" . "←") ("=>" . "⇒") ("<=" . "≤") (">=" . "≥") ("!=" . "≠") ("~=" . "≈") ("<->" . "↔")
    ("--" . "–") ("---" . "—") ("..." . "…") ("(c)" . "©") ("(r)" . "®") ("(tm)" . "™") ("1/2" . "½") ("1/4" . "¼") ("3/4" . "¾")
    ("+-" . "±") ("xx" . "×") ("deg" . "°")))

(setq *greek-lower* '(("a" . "α") ("b" . "β") ("g" . "γ") ("d" . "δ") ("e" . "ε") ("z" . "ζ") ("h" . "η") ("q" . "θ") ("i" . "ι") ("k" . "κ")
                      ("l" . "λ") ("m" . "μ") ("n" . "ν") ("x" . "ξ") ("o" . "ο") ("p" . "π") ("r" . "ρ") ("s" . "σ") ("t" . "τ") ("u" . "υ")
                      ("f" . "φ") ("c" . "χ") ("y" . "ψ") ("w" . "ω")))
(setq *greek-upper* '(("α" . "Α") ("β" . "Β") ("γ" . "Γ") ("δ" . "Δ") ("ε" . "Ε") ("ζ" . "Ζ") ("η" . "Η") ("θ" . "Θ") ("ι" . "Ι") ("κ" . "Κ")
                      ("λ" . "Λ") ("μ" . "Μ") ("ν" . "Ν") ("ξ" . "Ξ") ("ο" . "Ο") ("π" . "Π") ("ρ" . "Ρ") ("σ" . "Σ") ("τ" . "Τ") ("υ" . "Υ")
                      ("φ" . "Φ") ("χ" . "Χ") ("ψ" . "Ψ") ("ω" . "Ω")))
(define-input-method "greek" "a→α b→β g→γ ... (every letter is transliterated; capitals too)"
  (append *greek-lower*
          (map1 (lambda (p) (cons (str-upcase (car p)) (cdr (assoc (cdr p) *greek-upper*)))) *greek-lower*)))

(define-input-method "tex" "\\alpha α  \\to →  \\lambda λ  \\leq ≤  \\\"a ä  \\'e é  \\infty ∞ ..."
  (append
   '(("\\alpha" . "α") ("\\beta" . "β") ("\\gamma" . "γ") ("\\delta" . "δ") ("\\epsilon" . "ε") ("\\zeta" . "ζ") ("\\eta" . "η")
     ("\\theta" . "θ") ("\\iota" . "ι") ("\\kappa" . "κ") ("\\lambda" . "λ") ("\\mu" . "μ") ("\\nu" . "ν") ("\\xi" . "ξ")
     ("\\pi" . "π") ("\\rho" . "ρ") ("\\sigma" . "σ") ("\\tau" . "τ") ("\\upsilon" . "υ") ("\\phi" . "φ") ("\\chi" . "χ")
     ("\\psi" . "ψ") ("\\omega" . "ω") ("\\Gamma" . "Γ") ("\\Delta" . "Δ") ("\\Theta" . "Θ") ("\\Lambda" . "Λ") ("\\Xi" . "Ξ")
     ("\\Pi" . "Π") ("\\Sigma" . "Σ") ("\\Phi" . "Φ") ("\\Psi" . "Ψ") ("\\Omega" . "Ω")
     ("\\to" . "→") ("\\rightarrow" . "→") ("\\leftarrow" . "←") ("\\leftrightarrow" . "↔") ("\\Rightarrow" . "⇒") ("\\Leftarrow" . "⇐")
     ("\\Leftrightarrow" . "⇔") ("\\mapsto" . "↦") ("\\uparrow" . "↑") ("\\downarrow" . "↓")
     ("\\leq" . "≤") ("\\geq" . "≥") ("\\neq" . "≠") ("\\approx" . "≈") ("\\equiv" . "≡") ("\\sim" . "∼")
     ("\\infty" . "∞") ("\\sum" . "∑") ("\\prod" . "∏") ("\\int" . "∫") ("\\partial" . "∂") ("\\nabla" . "∇") ("\\sqrt" . "√")
     ("\\forall" . "∀") ("\\exists" . "∃") ("\\in" . "∈") ("\\notin" . "∉") ("\\subset" . "⊂") ("\\subseteq" . "⊆") ("\\supset" . "⊃")
     ("\\cup" . "∪") ("\\cap" . "∩") ("\\emptyset" . "∅") ("\\land" . "∧") ("\\lor" . "∨") ("\\lnot" . "¬") ("\\top" . "⊤") ("\\bot" . "⊥")
     ("\\times" . "×") ("\\cdot" . "·") ("\\pm" . "±") ("\\div" . "÷") ("\\circ" . "∘") ("\\ldots" . "…") ("\\degree" . "°")
     ("\\euro" . "€") ("\\copyright" . "©") ("\\checkmark" . "✓") ("\\star" . "★") ("\\heart" . "♥") ("\\ss" . "ß") ("\\o" . "ø")
     ("\\ae" . "æ") ("\\aa" . "å") ("\\l" . "ł") ("\\lambda" . "λ")
     ("^0" . "⁰") ("^1" . "¹") ("^2" . "²") ("^3" . "³") ("^4" . "⁴") ("^n" . "ⁿ") ("_0" . "₀") ("_1" . "₁") ("_2" . "₂") ("_3" . "₃") ("_n" . "ₙ"))
   (accent-rules "\\\"" *umlauts*) (accent-rules "\\'" *acutes*) (accent-rules "\\`" *graves*)
   (accent-rules "\\^" *circs*) (accent-rules "\\~" *tildes*)))
