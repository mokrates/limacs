;; -*- limo -*-
;; limacs/lib/search.limo --- incremental search and query-replace.

(setq *last-search* "")

(defun fold-p (pat) (eq pat (str-downcase pat)))          ; smart case: lowercase pattern ignores case
(defun search-fwd (pat from fold)                           ; start pos of next match at/after FROM
  (let ((l (car from)) (c (cdr from)) (res ()) (n (buf-nlines)))
    (while (and (< l n) (not res))
      (let* ((s (buf-line l)) (s2 (if fold (str-downcase s) s)) (i (str-index s2 pat c)))
        (if i (setf res (cons l i)) (progn (setf l (+ l 1)) (setf c 0)))))
    res))
(defun search-bwd (pat from fold)                           ; match starting before FROM
  (let ((l (car from)) (c (cdr from)) (res ()))
    (while (and (>= l 0) (not res))
      (let* ((s (buf-line l)) (s2 (if fold (str-downcase s) s))
             (i (str-rindex s2 pat (imin (slen s2) (+ c (slen pat) -1)))))
        (cond ((and i (< i c)) (setf res (cons l i)))
              ((and i (not (= l (car from)))) (setf res (cons l i)))
              (:else (setf l (- l 1)) (when (>= l 0) (setf c (+ 1 (slen (buf-line l)))))))))
    res))

(defun search-overlays (pat fold)                           ; matches in the visible window
  (let ((res ()) (top (bf top)))
    (when (> (slen pat) 0)
      (for-each l (mdrange top (imin (buf-nlines) (+ top (text-height))))
        (let* ((s (buf-line l)) (s2 (if fold (str-downcase s) s)) (i (str-index s2 pat 0)))
          (while i
            (setf res (cons (list l i (+ i (slen pat)) 'isearch-other) res))
            (setf i (str-index s2 pat (+ i (imax 1 (slen pat)))))))))
    res))

(defun isearch (forward)
  (let* ((start (point)) (pat "") (stack ()) (match ()) (done ()) (failing ()) (wrapped ()) (dir forward))
    (defun status ()
      (message "%s%sI-search%s: %s" (if failing "Failing " "") (if wrapped "Wrapped " "") (if dir "" " backward") pat))
    (defun show ()
      (setf *extra-overlays* (search-overlays pat (fold-p pat)))
      (when (and match (> (slen pat) 0))
        (setf *extra-overlays* (cons (list (car match) (cdr match) (+ (cdr match) (slen pat)) 'isearch) *extra-overlays*)))
      (status)
      (mb-update-echo))
    (defun find-from (p)
      (let ((m (if dir (search-fwd pat p (fold-p pat)) (search-bwd pat p (fold-p pat)))))
        (cond (m (setf match m) (setf failing ())
                 (set-point (if dir (cons (car m) (+ (cdr m) (slen pat))) m)))
              (:else (setf failing :t)))))
    (finally
     (progn
       (show)
       (while (not done)
         (let ((e (read-event)))
           (cond ((eq e "C-g") (set-point start) (setf done :t) (setf *extra-overlays* ()) (throw 'quit))
                 ((member e '("C-s" "C-r"))
                  (let ((nd (eq e "C-s")))
                    (when (and (= (slen pat) 0) (> (slen *last-search*) 0)) (setf pat *last-search*))
                    (cond ((and failing (eq nd dir))
                           (setf wrapped :t) (find-from (if dir (cons 0 0) (buffer-end))))
                          (:else (setf dir nd)
                                 (find-from (cond ((not match) (point))
                                                  (dir (cons (car match) (+ (cdr match) 1)))
                                                  (:else match)))))))
                 ((eq e "DEL")
                  (when stack
                    (let ((st (car stack))) (setf stack (cdr stack))
                      (setf pat (car st)) (setf match (cadr st)) (setf failing (caddr st))
                      (when match (set-point (if dir (cons (car match) (+ (cdr match) (slen pat))) match)))
                      (when (not match) (set-point start)))))
                 ((eq e "RET") (setf done :t) (when (> (slen pat) 0) (setf *last-search* pat)))
                 ((eq e "C-w")
                  (let ((q (pos-forward-word (if match (cons (car match) (+ (cdr match) (slen pat))) (point)))))
                    (when (= (car q) (point-line))
                      (setf stack (cons (list pat match failing) stack))
                      (setf pat (string-concat pat (buffer-substring (if match (cons (car match) (+ (cdr match) (slen pat))) (point)) q)))
                      (find-from (if match match (point))))))
                 ((printable-key-p e)
                  (setf stack (cons (list pat match failing) stack))
                  (setf pat (string-concat pat (key->char e)))
                  (find-from (cond ((not match) (point)) (:else match))))
                 (:else (setf done :t) (when (> (slen pat) 0) (setf *last-search* pat)) (unread-event e)))
           (unless done (show)))))
     (progn (setf *extra-overlays* ()) (setf *mb-active* ())))
    (when (and (not done) ()) ())
    (when (> (slen pat) 0) (setf *last-search* pat))
    (unless failing (setf *message* ""))))
(defun mb-update-echo () ())

(defcommand isearch-forward () "Incremental search forward." (set-mark-quiet-if-needed) (isearch :t))
(defcommand isearch-backward () "Incremental search backward." (set-mark-quiet-if-needed) (isearch ()))
(defun set-mark-quiet-if-needed () ())

(defcommand query-replace () "Replace occurrences of a string, asking for each."
  (let* ((from (read-minibuffer "Query replace: " "" () 'replace-from))
         (to (read-minibuffer (string-concat "Query replace " from " with: ") "" () 'replace-to))
         (fold (fold-p from)) (count 0) (all ()) (quit ()) (start (point)))
    (when (= (slen from) 0) (user-error "Empty search string"))
    (finally
     (let ((m (search-fwd from (point) fold)))
       (while (and m (not quit))
         (set-point (cons (car m) (+ (cdr m) (slen from))))
         (let ((do-it ()))
           (cond (all (setf do-it :t))
                 (:else
                  (setf *extra-overlays* (list (list (car m) (cdr m) (+ (cdr m) (slen from)) 'isearch)))
                  (mb-update (string-concat "Query replacing " from " with " to ": (y/n/!/./q) ") "" 0)
                  (let ((e (read-event)))
                    (cond ((member e '("y" "SPC")) (setf do-it :t))
                          ((member e '("n" "DEL")) ())
                          ((eq e "!") (setf all :t) (setf do-it :t))
                          ((eq e ".") (setf do-it :t) (setf quit :t))
                          ((member e '("q" "RET" "C-g")) (setf quit :t))
                          (:else ())))))
           (when do-it
             (delete-between m (cons (car m) (+ (cdr m) (slen from))))
             (insert-at m to)
             (set-point (cons (car m) (+ (cdr m) (slen to))))
             (setf count (+ count 1))))
         (unless quit (setf m (search-fwd from (point) fold)))))
     (progn (setf *extra-overlays* ()) (setf *mb-active* ())))
    (message "Replaced %s occurrence%s" (num->str count) (if (= count 1) "" "s"))))
